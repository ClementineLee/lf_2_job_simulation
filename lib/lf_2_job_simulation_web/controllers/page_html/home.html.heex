<div class="card">
  <div class="card-body">
    <%= for m <- 0..(length(@body)-1) do %>
      <div class="card-body">
        <div class="card-title">{current_body = Enum.at(Enum.at(@body, m), 0)}</div>
        <%= for n <- 1..(length(Enum.at(@body, m))-1) do %>
          <div>{Enum.at(Enum.at(@body, m), n)}</div>
        <% end %>
      </div>
    <% end %>
    <div class="hidden">
      {list_sites_stage_1 = [
        "/basis_informationen",
        "/quiz",
        "/basis_informationen",
        "/willkommen"
      ]}
      {list_sites_stage_2 = [
        "/unsere_Produkte"
      ]}
    </div>
    <%= cond do %>
      <% @conn.request_path in list_sites_stage_2 -> %>
        <div>
          <.link href="/simulation">
            <.button>Zu der Simulation</.button>
          </.link>
        </div>
      <% true -> %>
        <%= if(@conn.request_path not in ["/quiz", "/impressum"]) do %>
          <%= if(@conn.request_path != "/basis_informationen") do %>
            <div>
              <.link href="/basis_informationen">
                <.button>Zu den Basis Informationen</.button>
              </.link>
            </div>
          <% end %>
          <div>
            <.link href="/quiz">
              <.button>Zum Quiz</.button>
            </.link>
          </div>
        <% end %>
    <% end %>
  </div>
</div>

<script>
</script>
