<div class="card">
  <div class="card-body">
    <h2 class="card-title">Informationen zum Nachlesen</h2>

    <%= for {item, m} <- Enum.with_index(@body) do %>
      <div class="card bg-base-100 shadow-md mb-3">
        <%!-- Hauptüberschrift --%>
        <div
          class="card-body cursor-pointer"
          phx-click={
            JS.toggle_class("hidden", to: "#body-#{m}")
            |> JS.toggle_class("rotate-180", to: "#arrow-#{m}")
          }
        >
          <h2 class="card-title">
            <span>{Enum.at(Enum.at(item, 0), 0)}</span>

            <span
              id={"arrow-#{m}"}
              class="transition-transform duration-300"
            >
              ▼
            </span>
          </h2>
        </div>

        <div id={"body-#{m}"} class="hidden px-5 pb-5">
          <%= for {subitem, n} <- Enum.with_index(item) do %>
            <%= if n == 0 do %>
              <%!-- Wichtigste in Kürze: immer sichtbar --%>
              <div class="mb-4">
                <%= for {content, i} <- Enum.with_index(subitem) do %>
                  <%= if i > 0 do %>
                    <%= if String.starts_with?(content, "[[IMAGE:") and String.ends_with?(content, "]]") do %>
                      <% filename =
                        content
                        |> String.replace_prefix("[[IMAGE:", "")
                        |> String.replace_suffix("]]", "") %>

                      <div class="my-4">
                        <img
                          src={~p"/images/#{filename}"}
                          alt="Abbildung"
                          class="max-w-full h-auto rounded-lg"
                        />
                      </div>
                    <% else %>
                      <p class="py-1">
                        {content}
                      </p>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <%!-- Weitere Unterkategorien --%>
              <div class="mb-3">
                <div
                  class="py-3 cursor-pointer flex justify-between items-center"
                  phx-click={
                    JS.toggle_class("hidden", to: "#subbody-#{m}-#{n}")
                    |> JS.toggle_class("rotate-180", to: "#subarrow-#{m}-#{n}")
                  }
                >
                  <span class="font-semibold">
                    {Enum.at(subitem, 0)}
                  </span>

                  <span
                    id={"subarrow-#{m}-#{n}"}
                    class="transition-transform duration-300"
                  >
                    ▼
                  </span>
                </div>

                <div
                  id={"subbody-#{m}-#{n}"}
                  class="hidden pl-3 pb-3"
                >
                  <%= for {content, i} <- Enum.with_index(subitem) do %>
                    <%= if i > 0 do %>
                      <%= if String.starts_with?(content, "[[IMAGE:") and String.ends_with?(content, "]]") do %>
                        <% filename =
                          content
                          |> String.replace_prefix("[[IMAGE:", "")
                          |> String.replace_suffix("]]", "") %>

                        <div class="my-4">
                          <img
                            src={~p"/images/#{filename}"}
                            alt="Abbildung"
                            class="max-w-full h-auto rounded-lg"
                          />
                        </div>
                      <% else %>
                        <p class="py-1">
                          {content}
                        </p>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
    <.link href="/simulation">
      <.button>Zur Simulation</.button>
    </.link>
  </div>
</div>
