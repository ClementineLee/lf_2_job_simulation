<script>
  function initializeAutosave() {
    const clearAutosave =
      <%= Phoenix.Flash.get(@flash, :clear_autosave) == "true" %>;

    if (clearAutosave) {
      Object.keys(localStorage)
        .filter(key => key.startsWith("quiz_"))
        .forEach(key => localStorage.removeItem(key));

      return;
    }

    const inputs = document.querySelectorAll("[data-autosave]");

    inputs.forEach(input => {
      const key = "quiz_" + input.name;

      // Gespeicherte Antwort wiederherstellen
      const saved = localStorage.getItem(key);

      if (input.type === "radio") {
        input.checked = saved === input.value;
      } else if (saved !== null) {
        input.value = saved;
      }

      // Verhindert doppelte Event-Listener
      if (input.dataset.autosaveInitialized === "true") {
        return;
      }

      input.dataset.autosaveInitialized = "true";

      // Änderungen speichern
      input.addEventListener("change", () => {
        if (input.type === "radio") {
          if (input.checked) {
            localStorage.setItem(key, input.value);
          }
        } else {
          localStorage.setItem(key, input.value);
        }
      });
    });
  }

  // Normaler Seitenaufruf
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeAutosave);
  } else {
    initializeAutosave();
  }

  // Phoenix LiveView Navigation
  window.addEventListener("phx:page-loading-stop", initializeAutosave);
</script>

{@inner_content}
